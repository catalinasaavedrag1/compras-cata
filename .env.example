# URL del backend de la Plataforma de Compras.
# - Déjalo vacío o sin definir para "modo demo" (datos mock, ej. GitHub Pages).
# - Defínelo para conectar el frontend al backend real (npm run server).
#
# Copia este archivo a .env.local y descomenta la línea:
# VITE_API_URL=http://localhost:4100/api

# URL base del purchase-bff-service (API real de recomendaciones de reposición).
VITE_PURCHASE_BFF_URL=
# Token JWT de desarrollo para el purchase-bff-service (si la sesión no trae token).
VITE_PURCHASE_BFF_TOKEN=

# Login: por defecto va contra el BFF ({VITE_PURCHASE_BFF_URL}/auth/login),
# que hace de proxy a id-service. No requiere configuración extra si el BFF
# está definido. VITE_AUTH_URL solo si quieres un endpoint de login distinto.
# Sin BFF ni VITE_AUTH_URL: modo desarrollo (el login no valida credenciales).
VITE_AUTH_URL=
